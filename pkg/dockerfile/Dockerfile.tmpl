FROM ghcr.io/jdx/mise:2026.10.12 AS mise

FROM debian:trixie-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git curl less make procps unzip bind9-dnsutils \
        iproute2 tinyproxy \
    && rm -rf /var/lib/apt/lists/*

# tinyproxy runs as this dedicated uid, configs root-owned
RUN getent passwd tinyproxy >/dev/null || \
    useradd --system --user-group --no-create-home tinyproxy
COPY --chmod=644 docker/tinyproxy.conf /etc/ccbox/tinyproxy.conf

COPY --from=mise /usr/local/bin/mise /usr/local/bin/mise
COPY docker/mise/ /etc/mise/
# default value is: /root/.cache/ms-playwright
ENV PATH=/usr/local/share/mise/shims:$PATH PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# generated by your config
# - HOME pins to /root so the install's npm junk (playwright) lands in the
# cleaned home.
# - Mise installs without --no-install-recommends
# - packages apply precedes mise install — the install runs the tools it installs
# - temp MISE_DATA_DIR exists because `mise install --system` doesn't put shims
# - $buildDeps stays unquoted for word-splits
# hadolint ignore=SC2086
RUN set -eux; \
    export HOME=/root; \
{{.BuildEnv}}    apt-get update; \
    mise bootstrap packages apply --yes; \
    buildDeps='{{.BuildDeps}}'; \
    apt-get install -y --no-install-recommends $buildDeps; \
    MISE_DATA_DIR=/usr/local/share/mise mise install; \
    apt-get purge -y --auto-remove $buildDeps; \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 ccbox && useradd --uid 1000 --gid ccbox --shell /bin/bash --create-home ccbox
ENV DEVCONTAINER=true TZ="America/New_York"
COPY --chmod=755 dist/ccboxtools /usr/local/bin/ccboxtools

# generated by your config
ENV PATH=/opt/ccbox/clis/bin:/home/ccbox/.local/share/mise/shims:/home/ccbox/.local/bin:{{.PATHDirs}}:$PATH {{.EnvVars}}

# Two interactive-shell tweaks:
# - Debian's /etc/profile resets PATH on login shells (bash -l) — re-export the append above
# - zsh-style TAB completion: first TAB lists matches, repeats cycle, Shift-TAB reverses
RUN echo 'export PATH="'"$PATH"'"' > /etc/profile.d/ccbox-path.sh; \
    printf '%s\n' 'set show-all-if-ambiguous on' 'set menu-complete-display-prefix on' 'TAB: menu-complete' '"\e[Z": menu-complete-backward' >> /etc/inputrc

# Build-time cleanup + volume-mount groundwork: the mountpoints, and a
# read-only one for the allow bind.
RUN rm -rf /root/.cache /root/.npm /tmp; mkdir -m 1777 /tmp; \
    mkdir -p /opt/ccbox /etc/ccbox/proxy && chown ccbox:ccbox /opt/ccbox

# the name resolves in-image: ccbox's uid is pinned to 1000 at creation
# hadolint ignore=DL3066
USER ccbox

# data_bind_dirs pre-creates harness CLI mountpoints so their named volumes inherit uid 1000 (else root-owned, unwritable)
ARG data_bind_dirs=""
# Pre-created dirs let the named volumes mapped onto them inherit uid 1000;
# safe.directory handles repos owned by a non-matching host user - https://github.blog/open-source/git/git-security-vulnerability-announced/
# hadolint ignore=SC2086
RUN mkdir -p /home/ccbox/.cache /home/ccbox/.local /home/ccbox/.config /opt/ccbox/clis $data_bind_dirs && \
    git config --file /home/ccbox/.gitconfig --add safe.directory '*'

# generated by your config
RUN mkdir -p {{.CacheDirs}}

ENTRYPOINT ["/usr/local/bin/ccboxtools", "entrypoint"]

# The desktop variant: the headless base plus the VNC stack — TigerVNC serving
# XFCE, the session's browser wrapper, and the GUI app's Electron/OAuth bits.
FROM base AS vnc
# The stage inherits the base's ccbox USER; the apt row below needs root.
# hadolint ignore=DL3002,DL3066
USER root

# Only the dep-graph's tips — everything else lands via Depends:
# - libxss1, the one Electron runtime lib the base's browser install misses
# - tigervnc-tools, a Recommends of the server, which --no-install-recommends skips
# - dbus-x11 for the session bus; xdg-utils for the OAuth chain
# - xfonts-base for the X session
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxss1 \
        tigervnc-standalone-server tigervnc-tools dbus-x11 xdg-utils \
        xfwm4 xfce4-panel xfce4-session xfdesktop4 \
        xfonts-base \
    && rm -rf /var/lib/apt/lists/*

# The VNC session supervisor — the entrypoint's hook to start a GUI.
COPY --chmod=755 docker/desktop.sh /usr/local/bin/desktop
# .local is a per-project volume at runtime, so the .desktop entries bake to
# system dirs; .config is mount-free and bakes into the home.
COPY --chown=ccbox:ccbox docker/desktop/home/ /home/ccbox/
COPY docker/desktop/share/ /usr/local/share/
# default browser config — execs the base's shared playwright chromium.
COPY --chmod=755 docker/web-browser /usr/local/bin/web-browser
COPY docker/desktop/policies/ /

# The GUI app's volume mountpoint, ccbox-owned so the named volume seeds uid 1000
RUN mkdir -p /opt/ccbox/apps && chown ccbox:ccbox /opt/ccbox/apps

# the name resolves in-image: ccbox's uid is pinned to 1000 at creation
# hadolint ignore=DL3066
USER ccbox

# The default target
FROM base
