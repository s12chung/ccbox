{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/etc/claude-code/CLAUDE.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.envrc": "ask",
      "*secrets/*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "*.aws/*": "ask",
      "*.ssh/*": "ask"
    },
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow"
    }
  }
}
