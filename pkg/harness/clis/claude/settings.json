{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_CONFIG_DIR/statusline.sh\""
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",

      "Write(.ccbox.yaml)",
      "Edit(.ccbox.yaml)",
      "Write(.ccbox.local.yaml)",
      "Edit(.ccbox.local.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_CONFIG_DIR/hooks/secret-tripwire.sh\""
          }
        ]
      }
    ]
  }
}
