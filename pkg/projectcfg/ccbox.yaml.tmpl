# ccbox config template: every key is optional; unset keys keep ccbox's defaults.
# Levels (lowest first): user ~/.ccbox/config/ccbox.yaml, project .ccbox.yaml, git-ignored
# .ccbox.local.yaml, then ccbox flags. Lists append; maps merge.

# cli: which coding CLI the image installs and launches
# Changing this rebuilds the image. Defaults to claude.
cli:{{yaml .CLI}}

# host_git_config: read-only mount the host's ~/.config/git into the container so in-container git
# honors your global ignore/config/attributes. Defaults to true.
host_git_config:{{yaml .HostGitConfig}}

# tmpfs: workspace-relative dirs masked with a tmpfs, so in-container writes never reach the host
# Useful for protecting directories from the container
# Defaults appended when present in the workspace: .idea, .vscode
tmpfs:{{yaml .Tmpfs}}
  # - dist

# volumes: workspace-relative dirs masked with a PERSISTENT per-project volume to avoid collisions with host
# Defaults appended when present in the workspace: node_modules, .venv, vendor/bundle
volumes:{{yaml .Volumes}}
  # - vendor/bundle

# env: extra environment variables set in the container (cannot override the proxy/token vars).
env:{{yaml .Env}}
  # FOO: bar

# allowlist: domains the egress wall lets through. Each entry also matches all its subdomains,
# "ccbox-defaults" expands to built-in defaults (package registries, GitHub, etc.)
# Unset pulls in the built-ins; an explicit empty list allows nothing.
allowlist:{{yaml .Allowlist}}
  # - example.com
