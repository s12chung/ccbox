# Run `ccbox config` to see effective config. Arrays and maps merge down scoped configs.

# cli: which coding CLI the image installs and launches
cli:{{yaml .CLIName}}

# vnc: Experimental --vnc session via. port 5900 (macOS Screen Sharing is limited, clipboard sync, auto-resize, etc.)
vnc:
  # gui_app: zcode # the GUI app's name; empty means none
{{- if and .VNC .VNC.Config}}
  config:
    # resolution: the box's WxH for clients that can't auto-resize. defaults to {{defaultResolution}}
    resolution: {{.VNC.Config.Resolution}}
{{- else}}
  # config:
  #   resolution: the box's WxH for clients that can't auto-resize. defaults to {{defaultResolution}}
{{- end}}

# tmpfs_masks: hide project-relative directories behind a throwaway temp filesystem.
# Use for editor junk (.vscode) or throwaway build output. Directories that do not exist in the project are safely ignored.
tmpfs_masks:{{yaml .TmpfsMasks}}{{if .TmpfsMasks}} # `ccbox config defaults` for expansions{{end}}
  # - dist

# volume_masks: cover project-relative directories with a persistent per-project volume.
# Use for node_modules-like folders. Directories that do not exist in the project are safely ignored.
volume_masks:{{yaml .VolumeMasks}}{{if .VolumeMasks}} # `ccbox config defaults` for expansions{{end}}
  # - vendor/bundle

# read_only_globs: block writes to project-relative glob paths (files or directories) with read-only re-mounts.
# Use for files that must never change (configs, secrets). External container configuration cannot prevent reads.
# tmpfs_masks/volume_masks dirs are never re-mounted read-only. Paths that do not exist in the project are safely ignored.
read_only_globs:{{yaml .ReadOnlyGlobs}}{{if .ReadOnlyGlobs}} # `ccbox config defaults` for expansions{{end}}
  # - .conf

# read_only_binds: bind host dirs into the container read-only. Use for config shared across
# projects (AWS creds, CAs, dotfiles). Dirs missing on the host are safely ignored.
read_only_binds:{{yaml .ReadOnlyBinds}}
  # ~/.aws: ~/.aws
  # /srv/ca: /home/ccbox/.local/share/ca

# env: extra environment variables set in the container
env:{{yaml .Env}}
  # FOO: bar

# allowlist: domains the egress wall lets through. Each entry also matches all its subdomains
allowlist:{{yaml .Allowlist}}{{if .Allowlist}} # `ccbox config defaults` for expansions{{end}}
  # - example.com
