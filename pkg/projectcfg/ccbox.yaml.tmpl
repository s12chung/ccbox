# Run `ccbox config` to see effective config. Arrays and maps merge down scoped configs.

# cli: which coding CLI the image installs and launches
cli:{{yaml .CLI}}

# host_git_config: read-only mount the host's ~/.config/git
host_git_config:{{yaml .HostGitConfig}}

# tmpfsMasks: project-relative directories to mask with a temporary filesystem to block access.
# Directories that do not exist in the project are safely ignored.
tmpfsMasks:{{yaml .TmpfsMasks}}{{if .TmpfsMasks}} # `ccbox config defaults` for expansions{{end}}
  # - dist

# volumeMasks: project-relative directories to mask with a persistent volume to avoid host collisions.
# Useful for node_modules-like folders. Directories that do not exist in the project are safely ignored.
volumeMasks:{{yaml .VolumeMasks}}{{if .VolumeMasks}} # `ccbox config defaults` for expansions{{end}}
  # - vendor/bundle

# env: extra environment variables set in the container
env:{{yaml .Env}}
  # FOO: bar

# allowlist: domains the egress wall lets through. Each entry also matches all its subdomains
allowlist:{{yaml .Allowlist}}{{if .Allowlist}} # `ccbox config defaults` for expansions{{end}}
  # - example.com
