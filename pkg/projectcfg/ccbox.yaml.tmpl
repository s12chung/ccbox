# Run `ccbox config` to see effective config. Arrays and maps merge down scoped configs.

# cli: which coding CLI the image installs and launches
cli:{{yaml .CLI}}

# host_git_config: read-only mount the host's ~/.config/git
host_git_config:{{yaml .HostGitConfig}}

# tmpfs_masks: project-relative directories to mask with a temporary filesystem to block access.
# Directories that do not exist in the project are safely ignored.
tmpfs_masks:{{yaml .TmpfsMasks}}{{if .TmpfsMasks}} # `ccbox config defaults` for expansions{{end}}
  # - dist

# volume_masks: project-relative directories to mask with a persistent volume to avoid host collisions.
# Useful for node_modules-like folders. Directories that do not exist in the project are safely ignored.
volume_masks:{{yaml .VolumeMasks}}{{if .VolumeMasks}} # `ccbox config defaults` for expansions{{end}}
  # - vendor/bundle

# read_only_globs: project-relative globs of paths (files or dirs) to re-mount read-only.
# tmpfs_masks/volume_masks dirs are never re-mounted read-only. Paths that do not exist in the project are safely ignored.
read_only_globs:{{yaml .ReadOnlyGlobs}}{{if .ReadOnlyGlobs}} # `ccbox config defaults` for expansions{{end}}
  # - .conf

# env: extra environment variables set in the container
env:{{yaml .Env}}
  # FOO: bar

# allowlist: domains the egress wall lets through. Each entry also matches all its subdomains
allowlist:{{yaml .Allowlist}}{{if .Allowlist}} # `ccbox config defaults` for expansions{{end}}
  # - example.com
